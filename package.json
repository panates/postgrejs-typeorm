{
  "name": "typeorm-postgrejs",
  "description": "A pg-compatible facade over PostgreJS - run TypeORM on PostgreJS's wire-protocol client instead of pg",
  "version": "1.0.1",
  "author": "Panates",
  "license": "BSD-3-Clause",
  "private": true,
  "peerDependencies": {
    "postgrejs": ">=3.10.0 <4",
    "typeorm": ">=0.3.0 <2"
  },
  "peerDependenciesMeta": {
    "typeorm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@panates/eslint-config": "^2.1.6",
    "@panates/eslint-config-ts": "^2.1.6",
    "@panates/rman-preset": "^1.6.0",
    "@panates/tsconfig": "^2.1.6",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.43",
    "@swc/helpers": "^0.5.23",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "c8": "^12.0.0",
    "expect": "^30.4.1",
    "globals": "^17.7.0",
    "mocha": "^12.0.1",
    "pg": "^8.23.0",
    "pg-query-stream": "^4.17.0",
    "postgrejs": "^3.12.1",
    "prettier": "^3.9.4",
    "reflect-metadata": "^0.2.2",
    "rman": "^2.7.0",
    "typeorm": "^1.1.1",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig-build.json --noEmit",
    "test": "mocha",
    "precitest": "rman clean",
    "citest": "c8 mocha",
    "bench": "node --expose-gc benchmark/bench.mjs",
    "bench:report": "node benchmark/render-report.mjs",
    "prepare": "husky || true",
    "prepublishOnly": "echo 'Publish from the build directory - run rman publish, which generates that manifest itself.' && exit 1"
  },
  "type": "module",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.0"
  },
  "homepage": "https://www.postgrejs.com/",
  "contributors": [
    "Eray Hanoglu <e.hanoglu@panates.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/panates/postgrejs-typeorm.git"
  },
  "keywords": [
    "typeorm",
    "typeorm-driver",
    "pg",
    "node-postgres",
    "pg-compatible",
    "postgrejs",
    "postgresql",
    "postgres",
    "sql",
    "orm",
    "typescript",
    "wire-protocol",
    "no-native-bindings"
  ],
  "publishConfig": {
    "access": "public"
  }
}
